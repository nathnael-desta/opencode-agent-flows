{
  "name": "opencode-agent-flows",
  "version": "0.1.0",
  "description": "Shareable, provider-aware agentic flows for OpenCode",
  "type": "module",
  "main": "plugin.ts",
  "exports": {
    ".": "./plugin.ts"
  },
  "files": [
    "plugin.ts",
    "src/**/*.ts",
    "docs/",
    "examples/"
  ],
  "scripts": {
    "docs": "bun scripts/generate-docs.ts",
    "docs:check": "bun scripts/generate-docs.ts --check",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify": "bun run docs:check && bun test && tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.3.15"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathnael-desta/opencode-agent-flows.git"
  },
  "homepage": "https://github.com/nathnael-desta/opencode-agent-flows#readme",
  "bugs": {
    "url": "https://github.com/nathnael-desta/opencode-agent-flows/issues"
  }
}
